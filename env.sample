# Optional overrides. Copy to .env to use them:  cp env.sample .env
# Ajustes opcionales. Copia a .env para usarlos:   cp env.sample .env
#
# Docker Compose never reads this file, only .env. Nothing here has any
# effect until you copy it. Precedence: command line > .env > defaults.
#
# Docker Compose no lee este archivo, solo lee .env. Nada de aquí tiene
# efecto hasta que lo copies. Precedencia: línea de comandos > .env > defaults.


# --- Ports / Puertos ---
# Change them when another project already uses the port. Pick WP_PORT before
# installing: WordPress stores its own address in the database, so changing the
# port afterwards leaves the site redirecting to the old one.
# Cámbialos cuando otro proyecto ya use el puerto. Elige WP_PORT antes de
# instalar: WordPress guarda su propia dirección en la base de datos, así que
# cambiar el puerto después deja el sitio redirigiendo a la anterior.

#WP_PORT=80
#PMA_PORT=8080


# --- Database / Base de datos ---
# Only applied while initializing an empty ./data/. Afterwards they are
# stored in the data directory and changing them breaks the connection.
# Solo se aplican al inicializar un ./data/ vacío. Después quedan guardadas
# en el directorio de datos y cambiarlas rompe la conexión.

#DB_NAME=wordpress
#DB_USER=wordpress
#DB_PASSWORD=wordpress
#DB_ROOT_PASSWORD=password


# --- Table prefix / Prefijo de tablas ---
# Decide it before the first installation. Changing it later points
# WordPress at tables that do not exist.
# Decídelo antes de la primera instalación. Cambiarlo después hace que
# WordPress apunte a tablas que no existen.

#WP_PREFIX=dockwp_
